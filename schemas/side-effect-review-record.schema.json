{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/m0ntydad0n/sovereignty/schemas/side-effect-review-record.schema.json",
  "title": "Sovereignty Side-Effect Review Record",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "pattern": "(?i)^(result|execution_result|payload|approved_by|executed_at)$"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "packet_id",
    "effect_id",
    "review_decision",
    "reviewer_type",
    "reviewed_at",
    "execution_status"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "review_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "effect_id": {"type": "string", "minLength": 1},
    "review_decision": {"type": "string", "enum": ["approved", "denied", "modified", "needs_human"]},
    "reviewer_type": {"type": "string", "enum": ["main_agent", "human", "policy"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "execution_status": {"type": "string", "enum": ["not_executed", "executed", "failed"]},
    "authority_tool": {"type": "string", "minLength": 1},
    "modified_payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "result_ref": {"type": "string", "minLength": 1},
    "notes_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
